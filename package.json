{
  "name": "fantasy-analytics",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:reset": "docker compose down -v && docker compose up -d",
    "ingest": "tsx --env-file-if-exists=.env.local scripts/ingest.ts",
    "ingest:all": "tsx --env-file-if-exists=.env.local scripts/ingest.ts --seasons 2023-2026"
  },
  "dependencies": {
    "next": "^15.5.0",
    "pg": "^8.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
